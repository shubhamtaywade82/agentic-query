{
  "source": { "name": "orders" },
  "select": [
    { "field": { "entity": "orders", "field": "customer_id" } },
    { "field": { "entity": "orders", "field": "amount" }, "aggregate": "sum", "alias": "revenue" }
  ],
  "filters": [
    {
      "field": { "entity": "orders", "field": "status" },
      "operator": "eq",
      "value": "completed"
    }
  ],
  "groupBy": [
    { "entity": "orders", "field": "customer_id" }
  ],
  "orderBy": [
    {
      "field": { "entity": "orders", "field": "amount" },
      "direction": "desc"
    }
  ],
  "limit": 10
}
