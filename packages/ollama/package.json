{
  "name": "@agentic-query/ollama",
  "version": "0.1.0",
  "description": "Ollama model-provider adapter for Agentic Query",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
