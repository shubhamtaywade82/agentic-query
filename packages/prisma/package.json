{
  "name": "@agentic-query/prisma",
  "version": "0.2.0",
  "description": "Prisma adapter for Agentic Query",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentic-query/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/agentic-query.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://github.com/shubhamtaywade82/agentic-query#readme",
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/agentic-query/issues"
  },
  "keywords": ["ai", "llm", "orm", "prisma", "agent", "database"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
